{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/notes",
      "destination": "/base",
      "permanent": true
    },
    {
      "source": "/auditorias",
      "destination": "/analytics",
      "permanent": true
    },
    {
      "source": "/planes",
      "destination": "/soluciones",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<sub>.*)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
